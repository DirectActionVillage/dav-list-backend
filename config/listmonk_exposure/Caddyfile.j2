{# Managed by Ansible, so edit the role template instead. We publish this
   file, so it shouldn't include hosts or addresses. The engine has the same
   path list. #}
{
	# Caddy gets a Let's Encrypt certificate on its own. We don't set an ACME
	# email (so this box carries less about us). The admin API stays on
	# localhost:2019 (`caddy reload` needs it).
}

{{ listmonk_exposure_site }} {
	encode zstd gzip
	header Strict-Transport-Security "max-age={{ listmonk_exposure_hsts_max_age }}"

	# /admin* and /api* return 404, except the captcha challenge. This runs
	# first, so we exclude the captcha path here too.
	@blocked {
		path /admin* /api*
		not path {{ listmonk_exposure_captcha_path }}
	}
	handle @blocked {
		respond 404
	}

	# The public paths. We allow every method (one-click unsubscribe is a
	# POST). The click and open tracking paths (/link/* and /campaign/*)
	# aren't on the list. We don't specify a `log` directive, so Caddy doesn't
	# write an access log and we don't record your IP address here.
{% if listmonk_exposure_grant_form_enabled %}
	#
	# The grant form paths go to the engine too (which sends them on to the
	# grant handler). This box doesn't store them.
{% endif %}
{% set exposure_public = listmonk_exposure_public_paths
   + (listmonk_exposure_archive_paths if listmonk_exposure_archive_public else [])
   + (listmonk_exposure_grant_form_paths if listmonk_exposure_grant_form_enabled else []) %}
	@public path {{ exposure_public | join(' ') }}
	handle @public {
		reverse_proxy http://{{ listmonk_exposure_upstream_ip }}:{{ listmonk_exposure_upstream_port }}
	}

	# Everything else returns 404 (including / and /webhooks/*).
	handle {
		respond 404
	}
}
