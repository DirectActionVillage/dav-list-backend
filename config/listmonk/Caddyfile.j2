# We generate the files in this repo from a private repo. Edits here would
# be overwritten by the next export. To suggest a change, open an issue or
# a pull request. We'll make it in the private repo and re-export. See
# CONTRIBUTING.md for details.

{# We publish this file, so it can't hold hosts or addresses. The edge host
   has the same path list. #}
{
	# The admin API stays on localhost:2019 (`caddy reload` needs it).

	# The default logger would write an error entry for every failed proxy
	# request. The edge host adds the visitor's address to each request it
	# sends here, so that entry would hold it. The proxy handler's own error
	# line logs the whole request too, address and headers included. We
	# promise not to keep either, so the default logger drops both.
	log default {
		exclude http.log.error http.handlers.reverse_proxy
	}
}

# The link listener (all the edge host can see of this box). It's plain HTTP
# inside WireGuard, and only binds the link address.
http://:{{ listmonk_proxy_tunnel_port }} {
	bind {{ listmonk_proxy_tunnel_ip }}

	# The edge host cuts bodies off at the same size. We repeat the limit here
	# as a second line, in case the edge host's config is ever the weak one.
	request_body {
		max_size {{ listmonk_proxy_max_body }}
	}

	# /admin* and /api* return 404, except the captcha challenge. This runs
	# first, so we exclude the captcha path here too.
	@blocked {
		path /admin* /api*
		not path {{ listmonk_proxy_captcha_path }}
	}
	handle @blocked {
		respond 404
	}

{% if listmonk_grant_form_enabled %}
	# Grant form. Its own handler on loopback takes these (not listmonk). We
	# encrypt each application to the maintainers' age keys before it hits disk.
	@grantform path {{ listmonk_grant_form_paths | join(' ') }}
	handle @grantform {
		reverse_proxy {{ listmonk_grant_form_upstream }}
	}

{% endif %}
	# The public paths. We allow every method (one-click unsubscribe is a
	# POST).
	@public path {{ (listmonk_proxy_public_paths + (listmonk_proxy_archive_paths if listmonk_proxy_archive_public else [])) | join(' ') }}
	handle @public {
		reverse_proxy {{ listmonk_address }}
	}

	# Everything else returns 404, including /, /link/*, /campaign/*, and
	# /webhooks/*.
	handle {
		respond 404
	}
}

# The admin listener, where we reach the admin UI. It passes everything
# through, and the edge host can't reach it.
http://:{{ listmonk_proxy_lan_port }} {
	bind {{ ansible_host }}
	reverse_proxy {{ listmonk_address }}
}
